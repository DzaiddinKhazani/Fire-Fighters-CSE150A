digraph "hillclimb" {
  rankdir=TB; labelloc=t; fontsize=20;
  label="H. Hill climbing with BIC (learned from 2015-2022 data)"; fontname="Helvetica";
  node [shape=ellipse, style=filled, fontname="Helvetica", fontsize=13];
  edge [color="#555555", arrowsize=0.8];
  "burn_hist" [fillcolor="#EADCF8"];
  "elev" [fillcolor="#D9EAD3"];
  "fire" [fillcolor="#F4CCCC", shape=doubleoctagon];
  "rhmin" [fillcolor="#FDE2C2"];
  "slope" [fillcolor="#D9EAD3"];
  "tmax" [fillcolor="#FDE2C2"];
  "veg_cover" [fillcolor="#CFE2F3"];
  "veg_height" [fillcolor="#CFE2F3"];
  "veg_type" [fillcolor="#CFE2F3"];
  "wind" [fillcolor="#FDE2C2"];
  { rank=same; "elev"; "wind"; "burn_hist"; }
  "burn_hist" -> "fire";
  "burn_hist" -> "slope";
  "elev" -> "burn_hist";
  "elev" -> "slope";
  "elev" -> "veg_cover";
  "elev" -> "veg_height";
  "elev" -> "veg_type";
  "rhmin" -> "elev";
  "rhmin" -> "tmax";
  "rhmin" -> "veg_cover";
  "rhmin" -> "veg_height";
  "rhmin" -> "veg_type";
  "rhmin" -> "wind";
  "tmax" -> "elev";
  "tmax" -> "fire";
  "tmax" -> "veg_cover";
  "tmax" -> "veg_type";
  "veg_cover" -> "burn_hist";
  "veg_cover" -> "slope";
  "veg_cover" -> "veg_height";
  "veg_height" -> "burn_hist";
  "veg_height" -> "slope";
  "veg_type" -> "burn_hist";
  "veg_type" -> "veg_cover";
  "veg_type" -> "veg_height";
  "wind" -> "elev";
  "wind" -> "tmax";
  "wind" -> "veg_type";
  subgraph cluster_legend { label="Legend"; fontsize=12; style=rounded; "_weather" [label="weather", fillcolor="#FDE2C2", shape=box, fontsize=10]; "_terrain" [label="terrain", fillcolor="#D9EAD3", shape=box, fontsize=10]; "_fuel" [label="fuel", fillcolor="#CFE2F3", shape=box, fontsize=10]; "_history" [label="history", fillcolor="#EADCF8", shape=box, fontsize=10]; "_target" [label="target", fillcolor="#F4CCCC", shape=box, fontsize=10]; }
}